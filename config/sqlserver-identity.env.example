# Copy this file to .data/sqlserver-identity.env for local development.
# These values are placeholders only and do not connect to a real database.
TASKBOARD_SQLSERVER_HOST=sqlserver.example.internal
TASKBOARD_SQLSERVER_PORT=1433
TASKBOARD_SQLSERVER_USER=taskboard_demo_user
TASKBOARD_SQLSERVER_PASSWORD=not-a-real-password
TASKBOARD_SQLSERVER_DATABASE=dashi_taskboard_example
TASKBOARD_SQLSERVER_ENCRYPT=false
TASKBOARD_SQLSERVER_TRUST_CERT=true
